APP_NAME=ACADEXXA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Douala
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=acadexxa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=acadexxa_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── E-mails ──────────────────────────────────────────────────────────────
# Every e-mail (notifications, news, registration and two-factor codes) goes through Brevo's API as
# soon as an API key exists. The key and the sender are best typed in Admin → Settings → E-mails
# (kept encrypted in the database, shared by the web and the scheduler services); they can also be
# given here. Brevo: SMTP & API → API keys → Generate a new API key (it starts with "xkeysib-").
# The sender must be validated in Brevo → Senders, domains & dedicated IPs.
BREVO_API_KEY=
MAIL_FROM_ADDRESS="noreply@acadexxa.com"
MAIL_FROM_NAME="${APP_NAME}"
# Used only while there is no Brevo key: "log" writes the e-mails to storage/logs instead of sending them.
MAIL_MAILER=log

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── LMS limits ───────────────────────────────────────────────────────────
# Videos are uploaded in chunks, so they are not limited by upload_max_filesize.
LMS_VIDEO_MAX_MB=20
LMS_VIDEO_CHUNK_MB=1
LMS_RESOURCE_MAX_MB=35
LMS_SUBMISSION_MAX_MB=25

# "Continue with Google" (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorized redirect URI: <APP_URL>/auth/google/callback. The button is hidden while these are empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-domain/auth/google/callback

# LMS_INACTIVE_DAYS=7
